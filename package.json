{
  "name": "dsh-plugin-verdict-guard",
  "version": "0.1.0",
  "description": "Native DeepSeek Harness plugin: a turn that states a verdict without evidence does not end \u2014 it is steered back for proof.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-agent-loop": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-agent-loop-testkit": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-session-persistence": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.8 <0.2.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.8 <0.2.0-0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.8 <0.2.0-0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "agent",
    "hooks",
    "honesty",
    "verification"
  ],
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "examples/**"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagetta1/dsh-verdict-guard.git"
  },
  "homepage": "https://github.com/sagetta1/dsh-verdict-guard#readme",
  "bugs": {
    "url": "https://github.com/sagetta1/dsh-verdict-guard/issues"
  },
  "author": "Sagit Nabiev <sagit.nabiev@gmail.com>",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
